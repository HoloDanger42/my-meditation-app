{
  "cli": {
    "version": ">= 14.7.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_JSON": "{{secrets.GOOGLE_SERVICES_JSON}}"
      },
      "prebuildCommand": "echo \"$GOOGLE_SERVICES_JSON\" > android/app/google-services.json"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "{{secrets.GOOGLE_SERVICES_JSON}}"
      },
      "prebuildCommand": "echo \"$GOOGLE_SERVICES_JSON\" > android/app/google-services.json"
    },
    "production": {
      "env": {
        "GOOGLE_SERVICES_JSON": "{{secrets.GOOGLE_SERVICES_JSON}}"
      },
      "prebuildCommand": "echo \"$GOOGLE_SERVICES_JSON\" > android/app/google-services.json"
    }
  },
  "submit": {
    "production": {}
  }
}
