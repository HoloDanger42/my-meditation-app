# AWS Triage Service Configuration
# DO NOT commit the actual .env file with real values!

# Your backend API Gateway endpoint
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod
EXPO_PUBLIC_API_ENDPOINT=https://your-api-gateway-url.amazonaws.com

# Firebase Configuration (already in google-services.json)
# These are for web builds if needed
# EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
