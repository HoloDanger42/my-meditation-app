# AWS Triage Service Configuration
# DO NOT commit the actual .env file with real values!

# Lambda #1: Presigned URL Generator (ChanseyApprover)
# Example: https://abc123xyz.lambda-url.us-east-1.on.aws
EXPO_PUBLIC_API_ENDPOINT=https://your-signer-lambda-url.on.aws

# Lambda #3: Result Reader (ChanseyReader)
# Example: https://xyz789abc.lambda-url.us-east-1.on.aws
EXPO_PUBLIC_READER_ENDPOINT=https://your-reader-lambda-url.on.aws

# Firebase Configuration (already in google-services.json)
# These are for web builds if needed
# EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
